# release signing credentials (never check in)
# Broader than the filenames currently in use: any .p8 notary key, any minisign
# secret. minisign.pub is deliberately NOT ignored -- release verification
# needs the public key in-tree.
*.p8
*.key
minisign.sec
!minisign.pub
.env
.env.*

# local scratch, not part of the repo
/scratchpad/

# per-machine agent/editor tooling, installed not authored
/.agents/
/.codex/
/.claude/skills/
/skills-lock.json
